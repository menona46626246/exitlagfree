# Build del agente desde el workspace. Contexto: raiz del repositorio.
FROM rust:1.85-alpine AS build
RUN apk add --no-cache musl-dev
WORKDIR /src
COPY . .
RUN cargo build --release -p tramo-node-agent

FROM alpine:3.20
RUN addgroup -S tramo && adduser -S -G tramo tramo
COPY --from=build /src/target/release/tramo-node-agent /usr/local/bin/tramo-node-agent
USER tramo
EXPOSE 8081/tcp
ENTRYPOINT ["/usr/local/bin/tramo-node-agent", "--addr", "0.0.0.0:8081"]
