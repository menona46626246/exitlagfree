<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paleta oscura de GameRoute Optimizer (tema por defecto). -->
    <SolidColorBrush x:Key="BgBrush" Color="#FF101318" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FF1A1F27" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="#FF222933" />
    <SolidColorBrush x:Key="BorderBrush2" Color="#FF2C3644" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFE8EDF2" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF8FA0B0" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF2F81E5" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#FF1B5BB5" />
    <SolidColorBrush x:Key="GoodBrush" Color="#FF2ECC71" />
    <SolidColorBrush x:Key="WarnBrush" Color="#FFF1C40F" />
    <SolidColorBrush x:Key="BadBrush" Color="#FFE74C3C" />

    <!-- Superficies específicas (entradas, código, gráficos, avisos). -->
    <SolidColorBrush x:Key="HoverBrush" Color="#FF2A3340" />
    <SolidColorBrush x:Key="CodeBrush" Color="#FF0D1014" />
    <SolidColorBrush x:Key="ChartBgBrush" Color="#FF141A21" />
    <SolidColorBrush x:Key="WarnBannerBgBrush" Color="#FF332A1E" />
    <SolidColorBrush x:Key="WarnBannerBorderBrush" Color="#FF6B4F15" />
    <SolidColorBrush x:Key="WarnTextBrush" Color="#FFFFE0A0" />
    <SolidColorBrush x:Key="NeutralBrush" Color="#FF555555" />
</ResourceDictionary>
