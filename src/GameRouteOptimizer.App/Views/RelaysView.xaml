<UserControl x:Class="GameRouteOptimizer.App.Views.RelaysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Relays (servidores WireGuard tuyos)" Style="{StaticResource HeaderText}"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Añadir" Style="{StaticResource AccentButton}" Command="{Binding AddCommand}" Margin="0,0,8,0"/>
            <Button Content="Editar" Command="{Binding EditCommand}" Margin="0,0,8,0"/>
            <Button Content="Medir salud" Command="{Binding MeasureCommand}" Margin="0,0,8,0"/>
            <Button Content="Activar/Desactivar" Command="{Binding ToggleCommand}" Margin="0,0,8,0"/>
            <Button Content="Eliminar" Command="{Binding RemoveCommand}" Margin="0,0,8,0"/>
            <Button Content="Importar .conf WireGuard" Command="{Binding ImportWgCommand}" Margin="0,0,8,0"/>
            <Button Content="Importar JSON" Command="{Binding ImportJsonCommand}" Margin="0,0,8,0"/>
            <Button Content="Exportar JSON (sin secretos)" Command="{Binding ExportJsonCommand}"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Relays}" SelectedItem="{Binding Selected}" Height="440">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="170"/>
                <DataGridTextColumn Header="Endpoint" Width="210">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="{}{0}:{1}">
                            <Binding Path="EndpointHost"/>
                            <Binding Path="EndpointPort"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="País/Ciudad" Width="130">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="{}{0} {1}">
                            <Binding Path="Country"/>
                            <Binding Path="City"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Salud" Binding="{Binding Health}" Width="90"/>
                <DataGridTextColumn Header="Relay→juego (est.)" Binding="{Binding RelayToGameMs, TargetNullValue='desconocido'}" Width="130"/>
                <DataGridTextColumn Header="Carga %" Binding="{Binding LoadPercent, TargetNullValue='—'}" Width="80"/>
                <DataGridCheckBoxColumn Header="Activo" Binding="{Binding IsEnabled}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="La medida de salud es aproximada (ICMP/TCP al endpoint); los endpoints WireGuard solo hablan UDP, por lo que 'sin respuesta' no implica que el relay no funcione. Las claves privadas importadas se cifran localmente (DPAPI en Windows) y nunca se exportan."
                   Style="{StaticResource DimText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
