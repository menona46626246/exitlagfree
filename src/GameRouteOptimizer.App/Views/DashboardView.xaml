<UserControl x:Class="GameRouteOptimizer.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:GameRouteOptimizer.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Juego:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedProfile}"
                          DisplayMemberPath="Name" MinWidth="240" Margin="0,0,12,0" />
                <Button Grid.Column="2" Content="Optimizar" Style="{StaticResource PrimaryButton}"
                        Command="{Binding OptimizeCommand}" />
                <Button Grid.Column="3" Content="Detener" Command="{Binding StopCommand}" />
                <Button Grid.Column="4" Content="Usar relay recomendado" Style="{StaticResource PrimaryButton}"
                        Visibility="{Binding CanConfirmRelay, Converter={StaticResource BoolToVisibility}}"
                        Command="{Binding ConfirmRelayCommand}" />
            </Grid>

            <!-- Avisos -->
            <Border Background="#332A1E" BorderBrush="#FF6B4F15" BorderThickness="1" CornerRadius="6"
                    Padding="10" Margin="0,10,0,0"
                    Visibility="{Binding GlobalModeWarning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="⚠ El perfil usa el modo TÚNEL GLOBAL: todo el tráfico del equipo pasará por el relay mientras esté activo. Asegúrate de que el proveedor del relay lo permite."
                           Foreground="#FFFFE0A0" />
            </Border>

            <!-- Métricas -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Margin="0,0,6,6" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="PING DIRECTO" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding DirectLatency}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource GoodBrush}" />
                        <TextBlock Text="{Binding DirectJitter, StringFormat=Jitter: {0}}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Margin="6,0,6,6" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="PÉRDIDA DIRECTA" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding DirectLoss}" FontSize="26" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Margin="6,0,6,6" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="PING VÍA TÚNEL" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding OptimizedLatency}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Margin="6,0,0,6" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="PÉRDIDA VÍA TÚNEL" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding OptimizedLoss}" FontSize="26" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <!-- Recomendación -->
                <Border Grid.Row="1" Grid.ColumnSpan="4" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,6" Padding="14,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💡 " FontSize="18" />
                        <StackPanel>
                            <TextBlock Text="{Binding RecommendationText}" FontSize="13" />
                            <TextBlock Text="{Binding ConfidenceText}" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding ActiveModeNote}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Gráficos en vivo -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Margin="0,0,6,0" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Latencia en vivo (ms)" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ctrl:LineChartControl Height="180" Values="{Binding LatencySamples}"
                                               Stroke="#FF2ECC71" UnitLabel="ms" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Margin="6,0,0,0" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Pérdida en vivo (%)" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ctrl:LineChartControl Height="180" Values="{Binding LossSamples}"
                                               Stroke="#FFF1C40F" UnitLabel="%" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
