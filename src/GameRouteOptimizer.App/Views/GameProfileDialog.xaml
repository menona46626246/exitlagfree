<Window x:Class="GameRouteOptimizer.App.Views.GameProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Perfil de juego" Width="640" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Nombre del juego *" Style="{StaticResource DimText}"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

                <TextBlock Text="Ejecutables (uno por línea, sin ruta)" Style="{StaticResource DimText}"/>
                <TextBox Height="56" Margin="0,4,0,2" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         Text="{Binding ExecutablesText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Ruta del ejecutable principal (opcional)" Style="{StaticResource DimText}" Margin="0,6,0,0"/>
                <TextBox Text="{Binding ExecutablePath}" Margin="0,4,0,10"/>

                <TextBlock Text="Argumentos de lanzamiento (opcionales)" Style="{StaticResource DimText}"/>
                <TextBox Text="{Binding LaunchArguments}" Margin="0,4,0,10"/>

                <TextBlock Text="Servidores objetivo — JSON (dominio/IP, puertos, región, protocolo, healthUrl)" Style="{StaticResource DimText}"/>
                <TextBox x:Name="ServersBox" Height="130" Margin="0,4,0,2" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                         Text="{Binding ServersJson, UpdateSourceTrigger=PropertyChanged}"/>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Protocolo preferido" Style="{StaticResource DimText}"/>
                        <ComboBox ItemsSource="{Binding ProtocolOptions}" SelectedItem="{Binding PreferredProtocol}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Modo de ruta" Style="{StaticResource DimText}"/>
                        <ComboBox ItemsSource="{Binding RoutingModeOptions}" SelectedItem="{Binding RoutingMode}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <CheckBox Content="Iniciar optimización automáticamente al arrancar el juego"
                          IsChecked="{Binding AutoStartOptimization}" Margin="0,12,0,0"/>
                <CheckBox Content="Detener optimización al cerrar el juego"
                          IsChecked="{Binding StopOnGameExit}" Margin="0,4,0,0"/>

                <TextBlock Text="Relay preferido (id, opcional)" Style="{StaticResource DimText}" Margin="0,10,0,0"/>
                <TextBox Text="{Binding PreferredRelayId}" Margin="0,4,0,10"/>

                <TextBlock Text="Reglas especiales (notas operativas)" Style="{StaticResource DimText}"/>
                <TextBox Text="{Binding SpecialRules}" Margin="0,4,0,10"/>

                <TextBlock Text="Notas" Style="{StaticResource DimText}"/>
                <TextBox Text="{Binding Notes}" Margin="0,4,0,10"/>

                <TextBlock Text="AVISO: el túnel global enruta TODO tu tráfico. El modo 'solo juego' enruta únicamente las IPs de los servidores definidos. Algunos juegos restringen VPN/routing en sus ToS."
                           Style="{StaticResource DimText}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Guardar" Style="{StaticResource AccentButton}" Click="Save_Click" Margin="0,0,8,0" MinWidth="100"/>
            <Button Content="Cancelar" Click="Cancel_Click" MinWidth="100"/>
        </StackPanel>
    </Grid>
</Window>
