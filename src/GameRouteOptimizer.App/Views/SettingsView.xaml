<UserControl x:Class="GameRouteOptimizer.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="2">
            <TextBlock Text="Configuración" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Tema oscuro · idioma: español (v1). Los cambios se aplican al guardar."
                       Style="{StaticResource Muted}" Margin="0,-6,0,10" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Probing -->
                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,10">
                    <StackPanel>
                        <TextBlock Text="Pruebas de red (probes)" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <CheckBox Content="Permitir ICMP (si el sistema lo permite)"
                                  IsChecked="{Binding Settings.Probing.UseIcmp}" Margin="0,2,0,0" />
                        <CheckBox Content="Reintentar con TCP connect si ICMP está bloqueado"
                                  IsChecked="{Binding Settings.Probing.TcpFallbackWhenIcmpBlocked}" Margin="0,2,0,0" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Probes modo rápido" Style="{StaticResource Muted}" />
                                <TextBox Text="{Binding Settings.Probing.QuickProbeCount, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Probes modo profundo" Style="{StaticResource Muted}" />
                                <TextBox Text="{Binding Settings.Probing.DeepProbeCount, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Timeout (ms)" Style="{StaticResource Muted}" />
                                <TextBox Text="{Binding Settings.Probing.TimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0">
                                <TextBlock Text="Intervalo (ms)" Style="{StaticResource Muted}" />
                                <TextBox Text="{Binding Settings.Probing.IntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Text="Puerto TCP por defecto" Style="{StaticResource Muted}" />
                                <TextBox Text="{Binding Settings.Probing.TcpDefaultPort, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Las probes usan rate limit bajo y solo a los destinos que añades."
                                   Style="{StaticResource Muted}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Auto-switch -->
                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Optimización automática (auto-switch)" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <CheckBox Content="Permitir cambiar de ruta automáticamente"
                                  IsChecked="{Binding Settings.AutoSwitch.Enabled}" Margin="0,2,0,0" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Mejora mínima para cambiar (ms)" Style="{StaticResource Muted}" />
                                <TextBox Text="{Binding Settings.AutoSwitch.MinImprovementMs, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Espera entre cambios (s)" Style="{StaticResource Muted}" />
                                <TextBox Text="{Binding Settings.AutoSwitch.CooldownSeconds, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Estabilidad exigida (s)" Style="{StaticResource Muted}" />
                                <TextBox Text="{Binding Settings.AutoSwitch.StabilityWindowSeconds, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Pérdida máx. para cambiar (%)" Style="{StaticResource Muted}" />
                                <TextBox Text="{Binding Settings.AutoSwitch.MaxLossForSwitchPct, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="Failback automático si el túnel falla o empeora"
                                  IsChecked="{Binding Settings.AutoSwitch.AutoFailback}" Margin="0,10,0,0" />
                        <TextBlock Text="Con histéresis: no se cambia por mejoras mínimas ni inestables."
                                   Style="{StaticResource Muted}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Túnel -->
                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,10">
                    <StackPanel>
                        <TextBlock Text="Túnel WireGuard" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="MTU" Style="{StaticResource Muted}" />
                                <TextBox Text="{Binding Settings.Tunnel.Mtu, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Timeout de conexión (s)" Style="{StaticResource Muted}" />
                                <TextBox Text="{Binding Settings.Tunnel.ConnectTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="DNS del túnel (IP IPv4; vacío = el del relay)" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                        <TextBox Text="{Binding Settings.Tunnel.DnsOverride, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="El DNS se aplica a la interfaz del túnel y, en modo «solo juego», se encamina por el túnel si el relay lo cubre (protección básica contra fugas DNS)."
                                   Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <CheckBox Content="Activar kill switch con el túnel (requiere administrador)"
                                  IsChecked="{Binding Settings.Tunnel.KillSwitchEnabled}" Margin="0,10,0,0" />
                        <TextBlock Text="El kill switch bloquea toda la salida salvo el túnel, el endpoint del relay y tu red local; se restaura siempre al detener (botón de emergencia incluido) y al arrancar si quedó de una sesión anterior. Si el túnel se cae y no se puede restaurar, puede aislarte de internet: úsalo con criterio."
                                   Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- General / privacidad -->
                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}"
                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,0,10">
                    <StackPanel>
                        <TextBlock Text="General, logs y privacidad" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <CheckBox Content="Detectar lanzamientos de juegos en segundo plano"
                                  IsChecked="{Binding Settings.WatchGameProcesses}" Margin="0,2,0,0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Nivel mínimo de log" Style="{StaticResource Muted}" />
                                <ComboBox ItemsSource="{Binding LogLevels}" SelectedIndex="{Binding LogLevelIndex}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Archivos de log retenidos" Style="{StaticResource Muted}" />
                                <TextBox Text="{Binding Settings.Logging.RetainedFiles, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Datos locales" Style="{StaticResource Muted}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding DataDirectoryText}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                        <Button Content="Abrir carpeta de datos" Command="{Binding OpenDataFolderCommand}" Margin="0,8,0,0" />
                        <TextBlock Text="Privacidad: sin telemetría, sin cuentas, sin nube. Claves privadas cifradas con DPAPI; los logs y la base de datos viven solo en tu equipo."
                                   Style="{StaticResource Muted}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="2,0,0,4">
                <Button Content="Guardar configuración" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                <Button Content="Descartar cambios" Command="{Binding DiscardCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
