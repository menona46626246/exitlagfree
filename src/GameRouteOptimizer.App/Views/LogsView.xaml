<UserControl x:Class="GameRouteOptimizer.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Logs (locales; nada sale de tu máquina)" Style="{StaticResource HeaderText}"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Filtro:" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding Filter}" Width="130" Margin="0,0,12,0"/>
            <Button Content="Exportar" Command="{Binding ExportCommand}" Margin="0,0,8,0"/>
            <Button Content="Limpiar" Command="{Binding ClearCommand}"/>
        </StackPanel>

        <ListBox ItemsSource="{Binding Entries}" Height="560" FontFamily="Consolas" FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
    </StackPanel>
</UserControl>
