<UserControl x:Class="GameRouteOptimizer.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="2">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Registros locales" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,14,0" />
            <TextBox Width="220" ToolTip="Filtrar (texto o nivel)" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center" />
            <Button Content="Refrescar" Command="{Binding RefreshCommand}" />
            <Button Content="Exportar" Command="{Binding ExportCommand}" />
            <Button Content="Limpiar" Command="{Binding ClearCommand}" />
        </StackPanel>

        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1" CornerRadius="8" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Utc, StringFormat={}{0:HH:mm:ss.fff}}" FontFamily="Consolas"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Grid.Column="1" FontFamily="Consolas">
                                    <Run Text="{Binding Level, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="{Binding Message}" FontFamily="Consolas" FontSize="12"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Text="{Binding EntryCountText}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
