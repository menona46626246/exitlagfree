<Window x:Class="GameRouteOptimizer.App.Views.FirstRunWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asistente inicial — GameRoute Optimizer"
        Width="720" Height="590"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Resources/app.ico"
        Background="{StaticResource BgBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Border Background="{StaticResource AccentGradient}" CornerRadius="4" Padding="7,2" Margin="0,0,10,0">
                    <TextBlock Text="PRIMEROS PASOS" Foreground="#FFFFFF" FontWeight="Black" FontSize="10"/>
                </Border>
                <TextBlock x:Name="StepCounterText" Text="Paso 1 de 3" Foreground="{StaticResource TextDimBrush}"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="StepTitleText" Text="Bienvenido a GameRoute Optimizer"
                       FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
        </StackPanel>

        <!-- Indicador de pasos -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
            <Border x:Name="Step1Pill" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,8,0">
                <TextBlock Text="1. Modo de trabajo" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="12"/>
            </Border>
            <Border x:Name="Step2Pill" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,8,0">
                <TextBlock Text="2. Primer juego / objetivo" Foreground="{StaticResource TextDimBrush}" FontWeight="SemiBold" FontSize="12"/>
            </Border>
            <Border x:Name="Step3Pill" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="10,7">
                <TextBlock Text="3. Prueba en vivo" Foreground="{StaticResource TextDimBrush}" FontWeight="SemiBold" FontSize="12"/>
            </Border>
        </UniformGrid>

        <!-- Contenido de pasos -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- PASO 1 -->
                <StackPanel x:Name="Step1Panel" Visibility="Visible">
                    <Border Style="{StaticResource GamerCard}" Margin="0,0,0,12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="🔍 Modo Diagnóstico (listo ahora mismo, sin VPS)"
                                       Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                       Text="No necesitas un servidor externo ni permisos de administrador para empezar. Puedes medir ping real (ICMP/TCP/UDP/HTTP), jitter, pérdida de paquetes y ejecutar traceroute con detección de cuellos de botella hacia los servidores que tú elijas."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GamerCard}" Margin="0,0,0,12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="🛡️ Modo Túnel WireGuard (opcional para cuando tengas un relay)"
                                       Foreground="{StaticResource CyanBrush}" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                       Text="Cuando dispongas de un servidor propio con WireGuard, podrás importar su archivo .conf en la pestaña Relays e instalar el servicio elevado para comparar tu ruta directa contra el relay. Si la ruta directa ya es más rápida, la app nunca forzará un túnel."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GamerCard}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="¿Qué deseas hacer ahora?" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                            <CheckBox x:Name="CreateProfileCheck" IsChecked="True"
                                      Content="Configurar mi primer juego o endpoint de prueba en el siguiente paso"/>
                            <TextBlock Text="Puedes cambiar o eliminar cualquier perfil más adelante desde Biblioteca de Juegos."
                                       Style="{StaticResource DimText}" Margin="22,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- PASO 2 -->
                <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                    <Border Style="{StaticResource GamerCard}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Define tu primer objetivo" FontWeight="Bold" FontSize="14"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="⚡ Rellenar prueba rápida (1.1.1.1:443)"
                                        Click="FillQuickTest_Click" Padding="10,6" FontSize="12"/>
                            </Grid>

                            <TextBlock Text="Nombre del juego o perfil" Style="{StaticResource DimText}"/>
                            <TextBox x:Name="ProfileNameBox" Text="Mi Juego" Margin="0,4,0,10"/>

                            <TextBlock Text="Ejecutable (.exe, sin ruta — sirve para detectar cuándo está abierto)" Style="{StaticResource DimText}"/>
                            <TextBox x:Name="ExecutableBox" Text="juego.exe" Margin="0,4,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="IP o dominio del servidor objetivo *" Style="{StaticResource DimText}"/>
                                    <TextBox x:Name="HostBox" Text="1.1.1.1" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Puerto TCP (opcional)" Style="{StaticResource DimText}"/>
                                    <TextBox x:Name="PortBox" Text="443" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Modo de ruta inicial" Style="{StaticResource DimText}"/>
                            <ComboBox x:Name="RoutingModeBox" Margin="0,4,0,8"/>

                            <TextBlock Text="Regla de honestidad: solo se prueban endpoints definidos explícitamente por ti (por ejemplo, la IP publicada de tu servidor o un host de prueba como 1.1.1.1)."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- PASO 3 -->
                <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                    <Border Style="{StaticResource GamerCard}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Verificación rápida de conectividad" FontWeight="Bold" FontSize="14"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="WizardSummaryText" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <Button x:Name="RunQuickProbeButton" Content="⚡ PROBAR LATENCIA EN VIVO"
                                    Style="{StaticResource AccentButton}" Click="RunQuickProbe_Click"
                                    HorizontalAlignment="Left" MinWidth="220" Margin="0,0,0,12"/>

                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12">
                                <TextBlock x:Name="QuickProbeResultText"
                                           Text="Pulsa el botón superior para ejecutar una medición real (ICMP/TCP) contra el servidor seleccionado."
                                           Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="DontShowAgainCheck" IsChecked="True"
                              Content="No volver a mostrar este asistente al iniciar (puedes abrirlo desde Dashboard o Configuración)"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Pie de navegación -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Omitir por ahora" Click="Skip_Click"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="BackButton" Content="← Anterior" Click="Back_Click" Margin="0,0,8,0" Visibility="Collapsed" MinWidth="100"/>
                <Button x:Name="NextButton" Content="Siguiente →" Style="{StaticResource AccentButton}" Click="Next_Click" MinWidth="120"/>
                <Button x:Name="FinishButton" Content="Finalizar" Style="{StaticResource AccentButton}" Click="Finish_Click" MinWidth="120" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
