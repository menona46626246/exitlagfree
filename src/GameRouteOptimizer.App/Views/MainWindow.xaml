<Window x:Class="GameRouteOptimizer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GameRouteOptimizer.App.ViewModels"
        xmlns:views="clr-namespace:GameRouteOptimizer.App.Views"
        Title="GameRoute Optimizer — Gamer Route Tuning"
        Width="1240" Height="780"
        MinWidth="1020" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource BgBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Mapeo VM → View para el shell de navegación -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamesViewModel}">
            <views:GamesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RelaysViewModel}">
            <views:RelaysView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
            <views:DiagnosticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SessionViewModel}">
            <views:SessionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}">
            <views:LogsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!--  BARRA DE TÍTULO GAMER ESTILO EXITLAG (CUSTOM TITLEBAR)       -->
        <!-- ============================================================= -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Branding: Logo ExitLag Style -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <!-- Icono Rayo Neón / Diamond -->
                    <Border Width="24" Height="24" CornerRadius="5" Background="{StaticResource AccentGradient}" Margin="0,0,10,0">
                        <Path Data="M 13,3 L 6,14 L 11,14 L 10,21 L 18,10 L 13,10 Z"
                              Fill="#FFFFFF" Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="GAMEROUTE" Foreground="{StaticResource TextBrush}"
                               FontWeight="Black" FontSize="14" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="3" Margin="8,0,0,0" Padding="5,1">
                        <TextBlock Text="PRO" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9"/>
                    </Border>
                </StackPanel>

                <!-- Centro: Píldora de Estado del Sistema -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="24,0,0,0">
                    <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="10,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0"/>
                            <TextBlock Text="ESTADO: EN LÍNEA • TÚNEL LISTO" Foreground="{StaticResource SuccessBrush}"
                                       FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Botones de Control de Ventana (Window Controls) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowControlButtonStyle}" Click="Minimize_Click" ToolTip="Minimizar">
                        <TextBlock Text="—" FontSize="11" FontWeight="Bold"/>
                    </Button>
                    <Button Style="{StaticResource WindowControlButtonStyle}" Click="Maximize_Click" ToolTip="Maximizar / Restaurar">
                        <TextBlock Text="□" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource WindowCloseButtonStyle}" Click="Close_Click" ToolTip="Cerrar">
                        <TextBlock Text="✕" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================= -->
        <!--  CUERPO PRINCIPAL: SIDEBAR + VISTA DE CONTENIDO               -->
        <!-- ============================================================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Barra Lateral de Navegación -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,14,0,0">
                        <TextBlock Text="OPTIMIZACIÓN" Foreground="{StaticResource TextMutedBrush}"
                                   FontWeight="Bold" FontSize="10" Margin="20,4,0,8"/>

                        <!-- Dashboard -->
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateDashboardCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontSize="15" Margin="0,0,12,0" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Juegos -->
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateGamesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎮" FontSize="15" Margin="0,0,12,0" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Biblioteca de Juegos" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Relays -->
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateRelaysCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌐" FontSize="15" Margin="0,0,12,0" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Relays WireGuard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Separator Background="{StaticResource BorderBrush}" Margin="18,12,18,12"/>

                        <TextBlock Text="HERRAMIENTAS" Foreground="{StaticResource TextMutedBrush}"
                                   FontWeight="Bold" FontSize="10" Margin="20,4,0,8"/>

                        <!-- Diagnóstico -->
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateDiagnosticsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="15" Margin="0,0,12,0" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Diagnóstico &amp; Ping" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Sesión / Historial -->
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateSessionCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="15" Margin="0,0,12,0" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Métricas &amp; Sesión" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Ajustes -->
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateSettingsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="15" Margin="0,0,12,0" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Configuración" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Logs -->
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateLogsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="15" Margin="0,0,12,0" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Registros (Logs)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Zona Inferior: Botón de Emergencia / KillSwitch -->
                    <Border Grid.Row="1" Background="{StaticResource HeaderBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14">
                        <StackPanel>
                            <Button Content="⛔ PARADA DE EMERGENCIA"
                                    Style="{StaticResource DangerButton}"
                                    Command="{Binding Dashboard.EmergencyStopCommand}"
                                    FontSize="11" FontWeight="Bold" Padding="10,9"
                                    ToolTip="Detiene túneles y restaura la tabla de rutas de Windows"/>
                            <TextBlock Text="Restaura red al instante si algo falla"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10" TextAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Contenedor de Vistas -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,20,28,24">
                <ContentControl Content="{Binding CurrentView}"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
