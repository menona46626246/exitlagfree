<Window x:Class="GameRouteOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameRoute Optimizer"
        Width="1280" Height="820"
        MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navegación + contenido -->
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="GameRoute Optimizer" FontSize="16" FontWeight="Bold" Margin="14,16,10,2" />
                    <TextBlock Text="Diagnóstico · Rutas · Túnel" Style="{StaticResource Muted}" Margin="14,0,10,14" />

                    <Button Content="◆  Panel principal" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateDashboard}" />
                    <Button Content="🎮  Juegos" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateGames}" />
                    <Button Content="🌐  Relays WireGuard" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateRelays}" />
                    <Button Content="🔬  Diagnóstico" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateDiagnostics}" />
                    <Button Content="📊  Sesión" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateSession}" />
                    <Button Content="⚙  Configuración" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateSettings}" />
                    <Button Content="🗒  Registros (logs)" Style="{StaticResource NavButton}"
                            Command="{Binding NavigateLogs}" />

                    <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="12,10" />

                    <TextBlock Text="Juego activo" Style="{StaticResource Muted}" Margin="14,2,10,2" />
                    <TextBlock Text="{Binding CurrentGameLabel}" FontWeight="SemiBold" Margin="14,0,10,10" />
                    <Button Content="🛑  Detener y restaurar red" Style="{StaticResource DangerButton}"
                            Command="{Binding EmergencyStopCommand}" Margin="12,4,12,14" />
                </StackPanel>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding Content}" />
        </Grid>

        <!-- Barra de estado -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <Ellipse Width="10" Height="10" Fill="{Binding StateBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding StateLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="{Binding StateDetail}" Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
