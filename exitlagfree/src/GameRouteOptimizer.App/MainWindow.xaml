<Window x:Class="GameRouteOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameRoute Optimizer"
        Width="1180" Height="760"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="#FF12161C" CornerRadius="8" Margin="12" Padding="24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="GameRoute Optimizer"
                           FontSize="30" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" />
                <TextBlock Text="Compilando el andamiaje (fase 0)… la interfaz completa se integra en las fases 2–9."
                           FontSize="14" Foreground="#FF9AA7B4" Margin="0,12,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
