{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tramo",
  "version": "0.1.0",
  "identifier": "org.tramo.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ../ui dev",
    "beforeBuildCommand": "pnpm --dir ../ui build"
  },
  "app": {
    "windows": [
      {
        "title": "Tramo — medicion de red",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis"],
    "icon": ["icons/icon.png"],
    "shortDescription": "Optimizador de red auditable para juegos",
    "longDescription": "Mide y compara rutas de red con tuneles WireGuard propios. Sin telemetria por defecto."
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [],
      "dialog": true
    }
  }
}
